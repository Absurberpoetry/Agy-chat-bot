{
  "bot_name": "Agy Chat Bot",
  "admins": [],
  "active_persona_id": "",
  "platforms": [
    {
      "id": "qq_napcat_1",
      "type": "onebot_v11",
      "enabled": false,
      "ws_url": "ws://127.0.0.1:3001",
      "access_token": "",
      "self_id": "",
      "user_blocklist": [],
      "private_blocklist": [],
      "reconnect_initial_seconds": 2.0,
      "reconnect_max_seconds": 60.0,
      "rpc_timeout_seconds": 5.0
    },
    {
      "id": "tg_bot_1",
      "type": "telegram",
      "enabled": false,
      "ws_url": "https://api.telegram.org",
      "access_token": "",
      "self_id": "",
      "user_blocklist": [],
      "private_blocklist": [],
      "reconnect_initial_seconds": 2.0,
      "reconnect_max_seconds": 60.0,
      "rpc_timeout_seconds": 15.0,
      "extra": {
        "proxy": "",
        "use_agy_proxy": true
      }
    },
    {
      "id": "custom_platform_ws",
      "type": "generic_ws",
      "enabled": false,
      "ws_url": "ws://127.0.0.1:4001/ws",
      "access_token": "",
      "self_id": "bot_01",
      "user_blocklist": [],
      "private_blocklist": []
    }
  ],
  "triggers": {
    "mention": {
      "enabled": true,
      "allow_at_all": false,
      "include_quote_at": false,
      "unknown_reply_at_behavior": "mention"
    },
    "quote": {
      "enabled": true
    },
    "keyword": {
      "enabled": true,
      "keywords": ["/ai", "小助手"],
      "regex_patterns": [],
      "case_sensitive": false,
      "exclude_keywords": []
    },
    "dice": {
      "enabled": false,
      "probability": 0.03,
      "min_message_length": 4,
      "cooldown_seconds": 180.0,
      "ignore_prefixes": ["/", "!", ".", "！"]
    },
    "context_llm": {
      "enabled": false
    }
  },
  "collector": {
    "wait_triggers": ["mention", "quote", "keyword"],
    "quiet_wait_seconds": 4.0,
    "max_wait_seconds": 15.0,
    "max_extra_messages": 5,
    "track_only_trigger_user": true,
    "context_message_limit": 25,
    "history_buffer_size": 100,
    "db_context_enabled": true,
    "compact_max_messages": 60,
    "compact_drop_by_count": 20,
    "compact_max_tokens": 12000,
    "compact_max_bytes": 0,
    "compact_drop_by_tokens": 20
  },
  "rate_limit": {
    "max_concurrent_requests": 1,
    "max_queue_size": 8,
    "user_cooldown_seconds": 12.0,
    "channel_min_interval_seconds": 3.0,
    "max_replies_per_channel_per_minute": 6
  },
  "reply": {
    "quote_trigger_message": true,
    "at_trigger_user": false,
    "reply_prefix": "",
    "max_reply_chars": 800,
    "segmented_reply": {
      "enabled": false,
      "only_llm_result": true,
      "interval_method": "random",
      "interval": "1.5,3.5",
      "words_count_threshold": 10000,
      "split_mode": "words",
      "regex": "[\\s\\S]+?(?:\\|\\|\\||$)",
      "split_words": ["|||"],
      "content_cleanup_rule": ""
    }
  },
  "agy": {
    "mode": "agy",
    "executable": "auto",
    "workspace_dir": "./bot_workspace",
    "data_dir": "./data",
    "settings_file": "./settings.antigravity-cli.bot.json",
    "proxy": "",
    "model": "",
    "fallback_models": [],
    "effort": "",
    "sandbox": false,
    "max_warm_processes": 2,
    "max_turns_per_session": 20,
    "turn_timeout_seconds": 90.0,
    "resume_on_restart": true,
    "rate_limit_cooldown_seconds": 180.0,
    "fatal_error_pause_seconds": 3600.0,
    "subagent_enabled": true,
    "subagent_model": "",
    "subagent_persona_id": "",
    "subagent_max_concurrent": 2,
    "subagent_timeout_seconds": 240.0,
    "subagent_handoff_to_main": true,
    "allow_command_execution": false,
    "model_profiles": {}
  },
  "webui": {
    "enabled": true,
    "host": "0.0.0.0",
    "port": 8618,
    "username": "",
    "password": "",
    "log_buffer_size": 1000
  },
  "logging": {
    "level": "INFO"
  }
}
